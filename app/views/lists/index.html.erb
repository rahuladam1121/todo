<% content_for :title, "Lists" %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1>My To-Do List</h1>
    <%= link_to "Add New To-Do Item", new_list_path, class: "btn btn-primary" %>
  </div>

  <p class="text-success"><%= notice %></p>

  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead class="table-light">
        <tr>
          <th scope="col">To-Do Item</th>
          <th scope="col">Completed</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody id="lists">
        <% @lists.each do |list| %>
          <tr id="<%= dom_id list %>">
            <td>
              <%= form_with model: list, class: "d-inline-flex align-items-center gap-2 mb-0" do |form| %>
                <%= hidden_field_tag :return_to, "index" %>
                <%= form.check_box :completed, class: "form-check-input m-0", onchange: "this.form.requestSubmit()", aria: { label: "Mark #{list.description} as completed" } %>
                <span><%= list.description %></span>
              <% end %>
            </td>
            <td>
              <span class="badge rounded-pill <%= list.completed? ? "text-bg-success" : "text-bg-secondary" %>">
                <%= list.completed? ? "Completed" : "Incomplete" %>
              </span>
            </td>
            <td>
              <div class="d-flex gap-2">
                <%= link_to "Show", list, class: "btn btn-outline-secondary btn-sm" %>
                <%= link_to "Edit", edit_list_path(list), class: "btn btn-outline-primary btn-sm" %>
                <%= button_to "Destroy", list, method: :delete, class: "btn btn-outline-danger btn-sm", form: { data: { turbo_confirm: "Are you sure?" } } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
