<% content_for :title, "Editing list" %>

<div class="container py-4">
  <div class="mb-4">
    <h1 class="h2 mb-1">Edit to-do item</h1>
    <p class="text-body-secondary mb-0">Update the description or completion status.</p>
  </div>

  <div class="card shadow-sm">
    <div class="card-body p-4">
      <%= render "form", list: @list %>
    </div>
  </div>

  <div class="mt-3 d-flex gap-3">
    <%= link_to "View item", @list, class: "link-secondary" %>
    <%= link_to "Back to list", lists_path, class: "link-secondary" %>
  </div>
</div>
