<% content_for :title, "New list" %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-8">
      <div class="mb-4">
        <h1 class="h2 mb-1">Add a to-do item</h1>
        <p class="text-body-secondary mb-0">Write down something you want to get done.</p>
      </div>

      <div class="card shadow-sm">
        <div class="card-body p-4">
          <%= render "form", list: @list, submit_label: "Add Item" %>
        </div>
      </div>

      <div class="mt-3">
        <%= link_to "Back to lists", lists_path, class: "link-secondary" %>
      </div>
    </div>
  </div>
</div>
